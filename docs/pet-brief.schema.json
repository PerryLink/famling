{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/famling/docs/pet-brief.schema.json",
  "title": "Famling Pet Brief",
  "description": "Read-only, redacted, expiring projection from Advisers to Pearl. No reasoning, secrets, documents, or emotional fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "expiresAt",
    "source",
    "counts",
    "today",
    "commitments",
    "risks",
    "facts",
    "mood",
    "suggestedLines",
    "redactions"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "const": "advisers" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["today", "commitments", "risks", "facts"],
      "properties": {
        "today": { "type": "integer", "minimum": 0, "maximum": 10 },
        "commitments": { "type": "integer", "minimum": 0, "maximum": 10 },
        "risks": { "type": "integer", "minimum": 0, "maximum": 10 },
        "facts": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "today": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "status": { "type": "string", "enum": ["open", "doing", "done"] }
        }
      }
    },
    "commitments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "matter", "who", "what", "due", "risk", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "matter": { "type": "string", "minLength": 1, "maxLength": 64 },
          "who": { "type": "string", "minLength": 1, "maxLength": 40 },
          "what": { "type": "string", "minLength": 1, "maxLength": 80 },
          "due": { "type": "string", "minLength": 1, "maxLength": 32 },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "summary", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "level": { "type": "string", "enum": ["low", "medium", "high"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 80 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 64 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "predicate", "value", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "subject": { "type": "string", "minLength": 1, "maxLength": 40 },
          "predicate": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "string", "minLength": 1, "maxLength": 80 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "mood": { "type": "string", "enum": ["calm", "focused", "concerned", "pleased"] },
    "suggestedLines": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "redactions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    }
  }
}
